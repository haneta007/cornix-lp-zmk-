#include <input/processors.dtsi>
#include "nape_layer_index.h"

/ {
    nape_motion: nape_motion {
        compatible = "nape,virtual-pointer";
        status = "okay";
    };

    nape_controls: nape_controls {
        compatible = "nape,virtual-pointer";
        status = "okay";
    };

    nape_motion_listener {
        compatible = "zmk,input-listener";
        device = <&nape_motion>;
        input-processors = <&zip_temp_layer NAPE_MOUSE_LAYER_INDEX NAPE_MOUSE_LAYER_TIMEOUT_MS>;
    };

    nape_controls_listener {
        compatible = "zmk,input-listener";
        device = <&nape_controls>;
    };
};
