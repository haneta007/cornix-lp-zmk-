config ZMK_NAPE_BRIDGE
    bool "Nape BLE HID to USB mouse bridge"
    depends on BT && BT_CENTRAL && BT_GATT_CLIENT && ZMK_POINTING && ZMK_SPLIT_ROLE_CENTRAL
    default y if SHIELD_CORNIX_NAPE_BRIDGE

config ZMK_NAPE_CURSOR_INERTIA
    bool "Nape cursor inertia"
    depends on ZMK_NAPE_BRIDGE
    default y
    help
      Add decaying cursor movement after a flick. Disable for comparison
      without changing cursor acceleration or the FN_SCROLL path.

config ZMK_NAPE_CURSOR_ACCELERATION
    bool "Nape cursor acceleration"
    depends on ZMK_NAPE_BRIDGE
    default y
    help
      Disable to pass raw cursor XY through without the firmware gain.
      The FN_SCROLL filter and scaler remain unchanged.

config ZMK_NAPE_TIMING_DIAGNOSTICS
    bool "Aggregate Nape input timing logs"
    depends on ZMK_NAPE_BRIDGE
    default n
    select LOG
    help
      Log negotiated BLE parameters and aggregate input timing once per
      second while reports are processed. Adds no thread or workqueue.

config ZMK_NAPE_ZERO_LATENCY
    bool "Use zero peripheral latency for Nape parameter requests"
    depends on ZMK_NAPE_BRIDGE
    default n
    help
      Experimental comparison: accept Nape peer parameter requests with
      latency zero, leaving their interval and supervision timeout unchanged.
      Does not modify Cornix links. May increase Nape battery consumption.

config ZMK_NAPE_NAME
    string "BLE HID device name to pair"
    default "Nape Pro"
    depends on ZMK_NAPE_BRIDGE

config ZMK_NAPE_DEBUG
    bool "Verbose Nape HID and BLE logging"
    default n
    depends on ZMK_NAPE_BRIDGE
    select LOG
    select USE_SEGGER_RTT
    select LOG_BACKEND_RTT

config ZMK_NAPE_BOND_DIAGNOSTICS
    bool "Log stored Bluetooth bonds for Nape diagnostics"
    default n
    depends on ZMK_NAPE_BRIDGE

config ZMK_NAPE_BOND_CLEANUP_ONLY
    bool "Remove only the previously identified Nape bonds and stop"
    default n
    depends on ZMK_NAPE_BRIDGE
